                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"Shape is {items, meta, counts}\", () => pm.expect(d).to.have.keys(\"items\", \"meta\", \"counts\"));",
                  "pm.test(\"Only own orders\", () => pm.expect(d.items.every((o) => o.buyer && o.buyer._id)).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
