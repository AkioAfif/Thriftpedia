                  "const d = pm.response.json().data;",
                  "pm.test(\"meta has paging fields\", () => pm.expect(d.meta).to.have.keys(\"total\", \"page\", \"limit\", \"totalPages\"));",
                  "pm.test(\"counts has every tab\", () => pm.expect(d.counts).to.have.keys(\"ALL\", \"PENDING\", \"PROCESSING\", \"SHIPPED\", \"COMPLETED\", \"CANCELLED\"));",
                  "pm.test(\"At most 10 items\", () => pm.expect(d.items.length).to.be.at.most(10));"
