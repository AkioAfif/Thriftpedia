{
  "info": {
    "name": "Thriftpedia - Order & Single-Stock",
    "description": "Order module requests. Set buyerAToken, buyerBToken, adminToken, productId and productId2 (two AVAILABLE products) before running. Run top to bottom: later requests use orderId/orderId2 saved by earlier ones. The runner is sequential, so it does not prove concurrency; use scripts/concurrent-purchase.js for that.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "POST /api/orders",
      "item": [
        {
          "name": "Create order (buyer A) - 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"orderId\", pm.response.json().data._id);",
                  "pm.test(\"Order is PENDING\", () => pm.expect(pm.response.json().data.status).to.eql(\"PENDING\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{buyerAToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Duplicate purchase (buyer B) - 409",
          "event": [
