                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Only own orders\", () => { const d = pm.response.json().data; pm.expect(d).to.be.an(\"array\"); d.forEach((o) => pm.expect(o).to.not.have.nested.property(\"buyer.password\")); });"
