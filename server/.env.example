MONGO_URI=mongodb://localhost:27017/thriftpedia
PORT=5000
JWT_SECRET=changeme

# Cloudinary (product photos). Required for photo upload; the server still starts without them,
# but POST /api/products/upload answers 503 until they are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Midtrans Snap (sandbox keys: dashboard.sandbox.midtrans.com > Settings > Access Keys).
# Without MIDTRANS_SERVER_KEY, /api/payments answers 503. The client key is for the frontend Snap.js.
# Notification URL to set in the Midtrans dashboard: https://<public-host>/api/payments/notification
MIDTRANS_SERVER_KEY=
# Settings > Access Keys > "Signature Secret Key": verifies webhook signatures.
# Leave empty on older accounts where notifications are signed with the server key.
MIDTRANS_SIGNATURE_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
