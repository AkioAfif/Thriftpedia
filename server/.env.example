MONGO_URI=mongodb://localhost:27017/thriftpedia
# Local only. On Railway, leave PORT unset: the platform injects it.
PORT=5000
# Production: a fresh random value, e.g. `openssl rand -hex 64`.
JWT_SECRET=changeme

# Frontend origin, used in password-reset links (no trailing slash).
CLIENT_URL=http://localhost:3000
# Comma-separated, exact-match origins allowed for direct cross-origin browser calls.
# Unset means none. Browsers normally go through the Next.js /api rewrite and do not need this.
CORS_ORIGINS=http://localhost:3000

# Reverse proxies in front of the app (for the visitor's real IP in rate limiting).
# Production on Railway behind the Vercel rewrite: 2. Leave unset locally.
TRUST_PROXY_HOPS=

# Brevo (password-reset email over HTTPS). Brevo > SMTP & API > API Keys.
# EMAIL_FROM must be a sender verified in Brevo > Senders; it can then send to any address.
BREVO_API_KEY=
EMAIL_FROM=Thriftpedia <you@gmail.com>

# Cloudinary (product photos). Required for photo upload; the server still starts without them,
# but POST /api/products/upload answers 503 until they are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Midtrans Snap (sandbox keys: dashboard.sandbox.midtrans.com > Settings > Access Keys).
# Without MIDTRANS_SERVER_KEY, /api/payments answers 503.
# Notification URL to set in the Midtrans dashboard: https://<public-host>/api/payments/notification
MIDTRANS_SERVER_KEY=
# Settings > Access Keys > "Signature Secret Key": verifies webhook signatures.
# Leave empty on older accounts where notifications are signed with the server key.
MIDTRANS_SIGNATURE_KEY=
MIDTRANS_IS_PRODUCTION=false
